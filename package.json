{
  "name": "my-site",
  "version": "0.1.0",
  "description": "Static site with Cloudflare Pages CI/CD baked in.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev src --port 3000",
    "build": "node scripts/check-build-output.cjs",
    "lint": "eslint --cache src/ functions/ tests/",
    "pretest": "node scripts/guard-tests-exist.cjs",
    "test": "node --test",
    "deploy": "wrangler pages deploy src --project-name $npm_package_name",
    "version:patch": "node scripts/bump-version.cjs patch",
    "version:minor": "node scripts/bump-version.cjs minor",
    "version:major": "node scripts/bump-version.cjs major",
    "postinstall": "node scripts/check-placeholders.cjs"
  },
  "files": [
    ".env.example",
    ".gitattributes",
    ".github/",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "docs/",
    "eslint.config.js",
    "functions/",
    "scripts/",
    "src/",
    "tests/",
    "wrangler.toml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/YOUR_SITE.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "wrangler": "^4.100.0"
  },
  "//overrides": "wrangler@4.x → miniflare → ws@8.18.0 is affected by GHSA-58qx-3vcg-4xpx (uninitialized memory disclosure, <8.20.1). The override pins the transitive dep until miniflare ships the bump upstream. Dev-only impact (wrangler is devDependency).",
  "overrides": {
    "ws": "^8.20.1"
  }
}
